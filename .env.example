HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Celebration expiry runs automatically in production. Uncomment to opt in
# locally or to override the production default.
# CELEBRATION_EXPIRY_CRON_ENABLED=false
BIRTHDAY_EXPIRY_EXCLUDED_ROUTES=elena,matt,mike

# Frontend links used in confirmation/reset and celebration emails.
FRONTEND_URL=https://www.wishhappybdayto.me
FRONTEND_RESET_PASSWORD_URL=https://www.wishhappybdayto.me/reset-password
# Set this after attaching a custom Strapi Cloud domain.
# PUBLIC_URL=https://auth.wishhappybdayto.me

# Production custom-domain email: verify this sender with SendGrid or Brevo.
# Configure either SENDGRID_API_KEY or both BREVO_SMTP_USER and BREVO_SMTP_KEY.
# SENDGRID_API_KEY=
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=
# EMAIL_DEFAULT_FROM=WishHappyBday <hello@wishhappybdayto.me>
# EMAIL_DEFAULT_REPLY_TO=hello@wishhappybdayto.me
