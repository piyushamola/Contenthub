    "leaseToken": {
      "type": "string",
      "private": true
    },
    "leaseUntil": {
      "type": "datetime"
    },
    "nextRunAt": {
      "type": "datetime"
    },
    "intentAt": {
      "type": "datetime"
    },
    "intentToken": {
      "type": "string",
      "private": true
    },
    "requestDigest": {
      "type": "string",
      "private": true
    },
    "providerId": {
      "type": "string"
    },
    "providerStatus": {
      "type": "string"
    },
    "tracking": {
      "type": "json",
      "private": true
    },
    "fulfillmentId": {
      "type": "string"
    },
    "approval": {
      "type": "json",
      "private": true
    },
    "snapshot": {
      "type": "json",
      "private": true
    },
    "reason": {
      "type": "string"
    }
  }
}
