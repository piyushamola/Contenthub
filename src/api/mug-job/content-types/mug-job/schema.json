{
  "kind": "collectionType",
  "collectionName": "mug_jobs",
  "info": {
    "singularName": "mug-job",
    "pluralName": "mug-jobs",
    "displayName": "mug-job"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "jobKey": {
      "type": "string",
      "private": true,
      "unique": true,
      "required": true,
      "column": {
        "unique": true
      }
    },
    "orderKey": {
      "type": "string",
      "private": true
    },
    "shopifyOrderId": {
      "type": "string"
    },
    "lineId": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "reference": {
      "type": "string",
      "private": true,
      "unique": true,
      "required": true,
      "column": {
        "unique": true
      }
    },
    "designCode": {
      "type": "string",
      "private": true,
      "unique": true,
      "required": true,
      "column": {
        "unique": true
      }
    },
    "state": {
      "type": "enumeration",
      "enum": [
        "queued",
        "intent",
        "reconcile",
        "submitted",
        "fulfillment_intent",
        "fulfillment_reconcile",
        "fulfilled",
        "hold"
      ],
      "default": "queued"
