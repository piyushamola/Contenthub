{
  "kind": "collectionType",
  "collectionName": "shopify_mug_orders",
  "info": {
    "singularName": "shopify-mug-order",
    "pluralName": "shopify-mug-orders",
    "displayName": "Mug order review",
    "description": "Paid Shopify mugs awaiting manual review. Review never submits to Qikink."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "orderKey": {
      "type": "string",
      "required": true,
      "unique": true,
      "column": {
        "unique": true
      },
      "private": true
    },
    "shopDomain": {
      "type": "string",
      "required": true
    },
    "shopifyOrderId": {
      "type": "string",
      "required": true
    },
    "hasMug": {
      "type": "boolean",
      "default": false
    },
    "stopRequested": {
      "type": "boolean",
      "default": false
    },
    "reviewDecision": {
      "type": "enumeration",
      "enum": [
        "pending",
        "reviewed",
        "rejected"
      ],
      "default": "pending",
      "required": true
    },
    "reviewNotes": {
      "type": "text"
    },
    "issues": {
      "type": "json"
    },
    "sourceDigest": {
      "type": "string",
      "private": true
    },
    "sourceUpdatedAt": {
      "type": "datetime"
    },
    "lastTopic": {
      "type": "string"
    },
    "snapshot": {
      "type": "json",
      "private": true
    },
    "revision": {
      "type": "integer",
      "default": 1
    },
    "artifacts": {
      "type": "json",
      "private": true
    },
    "approval": {
      "type": "json",
      "private": true
    },
    "productionHold": {
      "type": "boolean",
      "default": false
    },
    "holdReason": {
      "type": "string"
    }
  }
}
